# Production environment template for 剧本工作台 (Next.js 16.4.6)
# Copy to /opt/studio-workbench-3/shared/.env (chmod 0600) and adjust as needed.
# NEVER commit real API keys or secrets to git.

NODE_ENV=production
PORT=3199

# Concurrency for async episode transcription (default 4, clamped 1..6)
STUDIO_TRANSCRIBE_CONCURRENCY=4

# Concurrency for pre-LLM ffmpeg video transcoding (default 2, clamped 1..4)
STUDIO_FFMPEG_CONCURRENCY=2

# Skip transcoding when source MP4 is already <= threshold (default 3 MB)
STUDIO_VIDEO_COMPRESS_THRESHOLD_MB=3

# Per-request upstream LLM timeout in ms (default 120000)
STUDIO_LLM_TIMEOUT_MS=120000

# Optional explicit ffmpeg binary path (falls back to bundled ffmpeg-static, then PATH)
STUDIO_FFMPEG_PATH=/usr/bin/ffmpeg

# Upload limits (per file, MB) and upload concurrency slots
STUDIO_MAX_UPLOAD_MB=4096
STUDIO_MAX_CONCURRENT_UPLOADS=4
